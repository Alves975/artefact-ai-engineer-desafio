# Copy this example to .env and set your API key locally. Never commit real keys.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# To try the deterministic offline demonstration, set AI_PROVIDER=offline.
# The OpenAI provider remains optional: AI_PROVIDER=openai, OPENAI_API_KEY, OPENAI_MODEL.
